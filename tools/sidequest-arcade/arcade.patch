+.markdown strong { font-weight: 800; }
+.markdown em { color: var(--agent); }
+.markdown del { color: var(--text-muted); }
+.markdown a { color: var(--cyan); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
+.markdown a:hover { color: var(--accent); }
+
