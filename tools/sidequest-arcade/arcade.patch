+.markdown ul ul { list-style-type: "◆  "; }
+.markdown ul ul ul { list-style-type: "·  "; }
+.markdown ol { list-style-type: decimal; }
+.markdown ol ol { list-style-type: lower-alpha; }
+.markdown ul > li::marker { color: var(--accent); }
+.markdown ul ul > li::marker { color: var(--cyan); }
+.markdown ol > li::marker { color: var(--cyan); font-weight: 700; }
+.markdown li + li { margin-top: .3em; }
+.markdown li > :is(ul, ol) { margin: .3em 0 0; }
+.markdown li > p { margin: .3em 0; }
