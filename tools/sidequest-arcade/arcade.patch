+/* Rendered markdown (ticket descriptions and comments). Tailwind's preflight strips heading
+   sizes, list markers and margins, so everything a markdown viewer shows is set here. */
+.markdown { min-width: 0; color: var(--text); font-size: .88rem; line-height: 1.6; overflow-wrap: anywhere; }
+.markdown > :first-child { margin-top: 0; }
+.markdown > :last-child { margin-bottom: 0; }
+.markdown :is(p, ul, ol, blockquote, table, dl, .code-block, hr) { margin: 0 0 .9em; }
+
+.markdown :is(h1, h2, h3, h4, h5, h6) { margin: 1.5em 0 .6em; font-weight: 700; line-height: 1.3; letter-spacing: .01em; }
