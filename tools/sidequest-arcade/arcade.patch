+.markdown .code-copy[data-state="failed"] { border-color: var(--danger); color: var(--danger); }
+.markdown pre { margin: 0; padding: .75rem .9rem; overflow-x: auto; white-space: pre; tab-size: 4; }
+.markdown pre code { padding: 0; border: 0; background: none; color: var(--text); font-size: .84rem; line-height: 1.55; overflow-wrap: normal; }
+
+.markdown blockquote { padding: .35em .9em; border-left: 3px solid var(--accent); background: color-mix(in srgb, var(--accent-soft) 45%, transparent); color: var(--text-muted); }
+.markdown blockquote > :last-child { margin-bottom: 0; }
+.markdown hr { height: 2px; border: 0; background: var(--gradient); opacity: .75; }
+
+.markdown table { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
+.markdown :is(th, td) { padding: .4em .75em; border: 1px solid var(--border); text-align: left; vertical-align: top; }
+.markdown th { background: var(--surface-muted); color: var(--accent); font-weight: 700; }
